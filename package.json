{
  "name": "homepage",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run build-css && ng serve",
    "build-css": "tailwindcss -i ./src/tailwind.css -o ./src/generated-tailwind.css --minify",
    "build": "npm run build-css && ng build -c=production && npm run organize && npm run ghp404",
    "organize": "cp -r docs/browser/* docs/ && rm -rf docs/browser docs/3rdpartylicenses.txt docs/prerendered-routes.json",
    "ghp404": "cp docs/index.html docs/404.html",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:Homepage": "node docs/server/server.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.7",
    "@angular/cdk": "^22.1.7",
    "@angular/common": "^22.1.7",
    "@angular/compiler": "^22.1.7",
    "@angular/core": "^22.1.7",
    "@angular/forms": "^22.1.7",
    "@angular/platform-browser": "^22.1.7",
    "@angular/platform-browser-dynamic": "^22.1.7",
    "@angular/platform-server": "^22.1.7",
    "@angular/router": "^22.1.7",
    "@angular/ssr": "^22.1.8",
    "@faepoint/fp-uilib": "^22.0.3",
    "@ngrx/effects": "^22.0.1",
    "@ngrx/store": "^22.0.1",
    "@ngrx/store-devtools": "^22.0.1",
    "@tailwindcss/cli": "^4.3.1",
    "@tailwindcss/postcss": "^4.3.1",
    "animate.css": "^4.1.1",
    "emoji-toolkit": "^9.0.1",
    "express": "^5.1.0",
    "marked": "^15.0.12",
    "postcss": "^8.5.6",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.1.17",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.7",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.3",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  }
}
